{
  "info": {
    "name": "Campus Lab - new intake",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"created \" + pm.iterationData.get(\"firstName\"), () => {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set(\"studentId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\",\n  \"email\": \"{{firstName}}.{{lastName}}.{{$randomInt}}@students.campuslab.edu\",\n  \"programme\": \"{{programme}}\",\n  \"year\": {{year}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students"
          ]
        }
      }
    },
    {
      "name": "Read student back",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const s = pm.response.json();",
              "pm.test(\"the saved programme is \" + pm.iterationData.get(\"programme\"), () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(s.programme).to.eql(pm.iterationData.get(\"programme\"));",
              "  pm.expect(s.year).to.eql(pm.iterationData.get(\"year\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students",
            "{{studentId}}"
          ]
        }
      }
    },
    {
      "name": "Delete student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"cleaned up\", () => {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students",
            "{{studentId}}"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://campus-lab-production.up.railway.app/api/v1"
    },
    {
      "key": "studentId",
      "value": ""
    }
  ]
}